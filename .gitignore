/target
.loom/
.reasonix/
.qoder/
.claude/settings.local.json

# insta writes pending snapshots next to the source under test; they are
# review scratch, never source.
*.pending-snap

# release rehearsals leave detached-candidate scratch here; the sandbox is
# runtime residue, never source.
.release-sandbox/

# cargo cache residue that test-spawned cargo resolves against the repo root
# when a cache-root variable is relative or unset (finding captured in loom);
# never source, safe to delete.
/.global-cache
/.package-cache
/.package-cache-mutate
/registry/
/relative/
